{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Debug ui_main.py (DEBUG)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/ui_main.py",
            "args": [
                "--log-level",
                "DEBUG"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: Simulated H9 Dashboard",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/ui_main.py",
            "args": [
                "--simulate-h9",
                "--no-audio",
                "--no-gpio",
                "--log-level",
                "DEBUG"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: Screenshot Simulated H9",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/ui_main.py",
            "args": [
                "--simulate-h9",
                "--simulate-preset",
                "0",
                "--screenshot",
                "${workspaceFolder}/artifacts/dashboard.png",
                "--exit-after-screenshot",
                "--no-audio",
                "--no-gpio",
                "--log-level",
                "INFO"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
